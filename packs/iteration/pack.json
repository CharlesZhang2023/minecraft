{
  "id": "iteration",
  "kind": "shader",
  "version": "1.0.0",
  "name": "Iteration",
  "description": "Realistic light: a physically based sky, volumetric clouds and light shafts, soft shadows, ambient occlusion, wet rain, temporal anti-aliasing",
  "authors": ["Minecraft Web"],
  "credit": "In the spirit of iterationT (written from scratch for this game's WebGPU renderer)",
  "icon": "#5b8fd6",
  "settings": [
    { "id": "SHADOWS", "name": "Shadows", "type": "bool", "default": true },
    { "id": "SHADOW_RES", "name": "Shadow Quality", "type": "enum", "options": [1024, 2048, 4096], "labels": ["Low", "Medium", "High"], "default": 2048 },
    { "id": "SHADOW_DIST", "name": "Shadow Distance", "type": "number", "min": 64, "max": 256, "step": 16, "default": 128 },
    { "id": "PCSS", "name": "Soft Shadows (PCSS)", "type": "bool", "default": true, "description": "Shadows sharp near what casts them and soft farther away" },
    { "id": "CLOUDS", "name": "Volumetric Clouds", "type": "bool", "default": true },
    { "id": "CLOUD_STEPS", "name": "Cloud Quality", "type": "enum", "options": [12, 20, 32], "labels": ["Low", "Medium", "High"], "default": 20 },
    { "id": "CLOUD_COVER", "name": "Cloud Cover", "type": "number", "min": 0.1, "max": 0.9, "step": 0.05, "default": 0.45 },
    { "id": "VOLUMETRIC_LIGHT", "name": "Light Shafts", "type": "bool", "default": true },
    { "id": "FOG_DENSITY", "name": "Air Density", "type": "number", "min": 0, "max": 3, "step": 0.1, "default": 1.0 },
    { "id": "SSAO", "name": "Ambient Occlusion", "type": "bool", "default": true },
    { "id": "WATER_SSR", "name": "Water Reflections", "type": "bool", "default": true },
    { "id": "WET", "name": "Wet Rain and Puddles", "type": "bool", "default": true },
    { "id": "WAVING", "name": "Waving Plants", "type": "bool", "default": true },
    { "id": "TAA", "name": "Anti-aliasing (TAA)", "type": "bool", "default": true },
    { "id": "BLOOM", "name": "Bloom", "type": "bool", "default": true },
    { "id": "EXPOSURE", "name": "Exposure", "type": "number", "min": 0.4, "max": 2.5, "step": 0.05, "default": 1.0 },
    { "id": "SATURATION", "name": "Colour", "type": "number", "min": 0.6, "max": 1.4, "step": 0.05, "default": 1.0 }
  ],
  "shadow": { "enabled": "SHADOWS", "resolution": "SHADOW_RES", "distance": "SHADOW_DIST" },
  "common": ["common.wgsl"],
  "gbuffers": "gbuffers.wgsl",
  "passes": [
    { "name": "ssao", "file": "ssao.wgsl", "inputs": ["scene"], "scale": 0.5, "enabled": "SSAO" },
    { "name": "clouds", "file": "clouds.wgsl", "inputs": ["scene"], "scale": 0.5, "enabled": "CLOUDS" },
    { "name": "shafts", "file": "shafts.wgsl", "inputs": ["scene"], "scale": 0.5, "enabled": "VOLUMETRIC_LIGHT" },
    { "name": "composite", "file": "composite.wgsl", "inputs": ["scene", "ssao", "clouds", "shafts"] },
    { "name": "taa", "file": "taa.wgsl", "inputs": ["composite", "taaPrev"], "history": true, "enabled": "TAA" },
    { "name": "bright", "file": "bright.wgsl", "inputs": ["taa"], "scale": 0.5, "enabled": "BLOOM" },
    { "name": "bloom1", "file": "blur.wgsl", "inputs": ["bright"], "scale": 0.25, "enabled": "BLOOM" },
    { "name": "bloom2", "file": "blur.wgsl", "inputs": ["bloom1"], "scale": 0.125, "enabled": "BLOOM" },
    { "name": "bloom3", "file": "blur.wgsl", "inputs": ["bloom2"], "scale": 0.0625, "enabled": "BLOOM" }
  ],
  "final": "final.wgsl",
  "vanillaClouds": false,
  "vanillaSun": false,
  "jitter": "TAA"
}
